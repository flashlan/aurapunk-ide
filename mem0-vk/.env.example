# ── mem0-vk configuration ─────────────────────────────────────────
# Copy to .env and fill in at least ONE extraction LLM provider key
# (the graph-memory entity/relation extraction needs it).

# ── Qdrant / collection ─────────────────────────────────────────
# MEM0_COLLECTION=mem0-vk
# MEM0_DEFAULT_USER=default

# ── API authentication ───────────────────────────────────────────
# Use the same random value in the Vibe Kanban backend and mem0-vk. When set,
# every non-health REST/MCP request must use Authorization: Bearer <token>.
# MEM0_API_TOKEN=
# Hosted Mem0: the server calls this authenticated endpoint before memory
# operations and only accepts {"active":true} for the account identity.
# MEM0_LICENSE_CHECK_URL=
# MEM0_LICENSE_CHECK_TOKEN=

# ── Vector dimension (must match the embedding backend) ──────────
# all-MiniLM-L6-v2 → 384 | text-embedding-3-small → 1536
# EMBED_DIM=384

# ── Embedding backends (first success wins) ──────────────────────
# 1. local (sentence-transformers container, CPU) — default
# EMBED_LOCAL_URL=http://embeddings:8001/v1
# EMBED_LOCAL_MODEL=sentence-transformers
# 2. llama-server (OpenAI-format /v1/embeddings)
# EMBED_LLAMA_URL=
# EMBED_LLAMA_MODEL=
# EMBED_LLAMA_KEY=
# 3. OpenAI
# OPENAI_API_KEY=
# EMBED_OPENAI_MODEL=text-embedding-3-small
# 4. OpenRouter
# EMBED_OPENROUTER_KEY=
# EMBED_OPENROUTER_MODEL=nvidia/llama-3.2-nv-embed:free

# ── Extraction LLM (failover chain) ───────────────────────────────
# MEM0_LLM_PROVIDER sets the PRIMARY. Any other provider below that has a URL
# + model (+ key for cloud) is tried automatically when the primary is
# rate-limited (429), errors, or returns no usable JSON — e.g. llama local
# primary, then groq, then openrouter. Configure as many as you have.
# provider: groq | openrouter | llama | openai
# (can also be changed at runtime via the app's Settings → Memory)
MEM0_LLM_PROVIDER=groq
# groq
# GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.6-27b
# llama-server (local, OpenAI /v1 base — no rate limits, fully private)
# MEM0_LLAMA_URL=http://192.168.1.99:8082/v1
# MEM0_LLAMA_MODEL=qwen38
# openrouter
# MEM0_OPENROUTER_KEY=
# MEM0_OPENROUTER_MODEL=openai/gpt-oss-20b:free
# openai-compatible (reuse any PAID key from your CLIs — DeepSeek, NVIDIA, etc.)
# MEM0_OPENAI_URL=https://api.deepseek.com/v1
# MEM0_OPENAI_KEY=
# MEM0_OPENAI_MODEL=deepseek-chat

# ── Jev / Laya extraction (0 tokens by default, optional real models) ──
# provider `jev` or `laya` extracts in-container, deterministically, in <1ms
# and 0 tokens (no external call). Point either at a real model and it judges
# the deterministic candidates (keeping only durable facts) before falling back
# to the deterministic extractor on any error/timeout.
# Jev (TypeSafe System One):
# MEM0_LLM_PROVIDER=jev
# TYPESAFE_API_KEY=apikey_...
# TYPESAFE_JEV_URL=https://api.typesafe.ai/v1/systemone
# TYPESAFE_JEV_MODEL=jev-latest
# Laya (self-hosted Docker container or AuraPunk Cloud gateway; /predict):
# MEM0_LLM_PROVIDER=laya
# MEM0_LAYA_URL=http://192.168.254.107:8010
# MEM0_LAYA_MODEL=laya-system1-v1
# Endpoint/key can also live in the runtime provider config (MEM0_JEV_URL /
# MEM0_JEV_KEY). embedded:// or a missing key means deterministic-only.

# ── Graph (Python container, NetworkX) ───────────────────────────
# Set GRAPH_URL="" to disable graph (vector-only).
# Graphs persist as GraphML under /data/graphs (volume graph_data), lazy-loaded
# on first access.
# GRAPH_URL=http://embeddings:8001
