{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Aurapunk IDE",
  "version": "0.2.45",
  "identifier": "ai.bloop.vibe-kanban",
  "build": {
    "beforeDevCommand": {
      "script": "concurrently \"pnpm run backend:dev:watch\" \"pnpm run local-web:dev\"",
      "cwd": "../.."
    },
    "devUrl": "http://localhost:3001",
    "frontendDist": "./splash"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' http://localhost:* ws://localhost:* http://127.0.0.1:* ws://127.0.0.1:*; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http://localhost:* http://127.0.0.1:*; connect-src 'self' http://localhost:* ws://localhost:* http://127.0.0.1:* ws://127.0.0.1:* https://aurapunk-cloud.datapoint.chatgpt.site"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "bundleName": "Aurapunk IDE"
    },
    "windows": {},
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "AI-powered development workspace",
    "longDescription": "Aurapunk IDE: Collaborative AI workspace for software development",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "macos-fps": {},
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExRTUwMTJBRTgxRThFMTYKUldRV2poN29LZ0hsRWUzUFVObWRiS2UyUVl4b2hJanJpMkdiMVBsYjFaVjBXTmxiQWlRNE42R2sK",
      "endpoints": [
        "https://localhost/disabled"
      ]
    }
  }
}
