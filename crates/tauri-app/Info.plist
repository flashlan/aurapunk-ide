<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Aurapunk IDE</string>
	<key>CFBundleName</key>
	<string>Aurapunk IDE</string>
	<key>NSDesktopFolderUsageDescription</key>
	<string>Aurapunk IDE needs access to your Desktop to manage local repositories and workspace files.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>Aurapunk IDE needs access to your Documents folder to manage projects and workspaces.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Aurapunk IDE needs access to your Downloads folder to import assets and repositories.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
			<key>127.0.0.1</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
